# Riguel Cuaderno de Campo Astronomico - Environment Variables

# Database
DATABASE_URL=sqlite+aiosqlite:///./riguel.db

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Timezone
TIMEZONE=Europe/Madrid

# Observatory (used for seed if table empty)
OBS_NOMBRE=Riguel
OBS_LAT=40.4168
OBS_LON=-3.7038
OBS_ALT=650.0
OBS_TZ=Europe/Madrid

# Images
IMAGES_DIR=./data/imagenes
IMAGES_URL_PREFIX=/imagenes

# Security (optional, for LAN exposure)
# API_KEY=your-secret-key-here